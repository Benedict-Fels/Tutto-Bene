  "steps": [
    "Zwiebel fein würfeln.",
    "Tofu mit Küchenpapier abtupfen, mit den Händen oder einer Gabel zerbröseln.",
    "Öl in Pfanne erhitzen, Zwiebeln 2-3 Minuten glasig anbraten.",
    "Zerbröselten Tofu dazu, 5 Minuten mitbraten, ab und zu umrühren.",
    "Hefeflocken, Kurkuma, Paprikapulver und Kala Namak dazugeben, gut vermischen.",
    "Sojajoghurt einrühren.",
    "2 Minuten bei kleiner Hitze erhitzen.",
    "Mit Salz und Pfeffer abschmecken.",
    "Mit Petersilie oder Schnittlauch bestreuen."
  ],
