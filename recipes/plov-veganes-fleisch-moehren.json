  "steps": [
    "Zwiebeln halbieren, in feine Halbringe schneiden.",
    "Möhren schälen, grob raspeln.",
    "Knoblauch pressen.",
    "Öl erhitzen, Zwiebeln 12 Minuten anbraten.",
    "Veganes Fleisch dazu, 6 Minuten mitbraten.",
    "Knoblauch dazu, 1 Minute mitbraten.",
    "Möhrenraspel dazu, 2 Minuten mitbraten.",
    "Reis, Wasser, Brühepulver, Lorbeerblätter, Rosinen und Gewürze dazugeben.",
    "Aufkochen, 20 Minuten bei kleiner Hitze köcheln lassen.",
    "Lorbeerblätter entfernen, mit Salz und Pfeffer abschmecken."
