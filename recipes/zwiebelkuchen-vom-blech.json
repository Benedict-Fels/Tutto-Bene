    { "amount": 30, "unit": "g", "name": "Brühepulver", "variety": null },
    { "amount": 2, "unit": "Prise", "name": "Muskatnuss", "variety": "gemahlen" }
  ],
  "steps": [
    "Pflanzendrink und Butter leicht erwärmen.",
    "Mehl, Salz und Zucker vermischen, Hefe dazu.",
    "Flüssigkeit dazugeben, 10 Minuten kneten.",
    "Mit feuchtem Tuch abdecken, 1 Stunde an warmem Ort gehen lassen.",
    "Backblech einfetten, mit Backpapier auslegen.",
    "Teig auf das Blech geben, flach drücken, 2,5 cm Rand formen.",
    "Abdecken, weitere 30 Minuten gehen lassen.",
    "Zwiebeln würfeln, Butter erhitzen, Zwiebeln ca. 10 Minuten glasig dünsten.",
    "Mehl dazu, 1 Minute erhitzen, abkühlen lassen.",
    "Räuchertofu würfeln, in Öl 3 Minuten anbraten.",
    "Kichererbsenmehl mit Kochsahne verrühren, unter die Zwiebeln rühren.",
    "Mit Kümmel, Brühepulver, Pfeffer und Muskat würzen.",
    "Zwiebelmasse auf dem Teig verteilen.",
    "Mit Tofuwürfeln bestreuen.",
    "50 Minuten bei 200 °C Ober-/Unterhitze auf mittlerer Schiene backen."
  ],
