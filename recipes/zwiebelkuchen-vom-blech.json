    { "amount": 30, "unit": "g", "name": "Mehl", "variety": "für den Belag" },
    { "amount": 50, "unit": "g", "name": "Kichererbsenmehl", "variety": null },
    { "amount": 150, "unit": "g", "name": "Räuchertofu", "variety": null },
    { "amount": 1, "unit": "EL", "name": "Pflanzenöl", "variety": null },
