  "steps": [
    "Sojaschnetzel in 1 l kochendem Wasser 15 Minuten einweichen.",
    "Abgießen, abspülen, mit Küchenpapier trockendrücken.",
    "Kidneybohnen und Linsen gut abtropfen lassen.",
    "Zwiebel fein würfeln, Knoblauch pressen.",
    "Öl erhitzen, Zwiebel 5 Minuten andünsten.",
    "Knoblauch dazu, 1 Minute mitdünsten.",
    "Bohnen, Linsen, Sojaschnetzel, Tomatenmark, Senf, Bratengewürz, Sojasauce und Petersilie im Mixer grob pürieren.",
    "Masse in Schüssel geben, Stärke und Zwiebel-Knoblauch dazu.",
    "Zu Teig verkneten, ganze Bohnen mit den Händen zerdrücken.",
    "18 Frikadellen formen.",
    "Öl erhitzen, Frikadellen 12 Minuten pro Seite bei mittlerer Hitze goldbraun braten."
  ],
