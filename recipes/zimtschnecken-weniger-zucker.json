  "steps": [
    "Mehl, Trockenhefe, Zucker und Salz vermischen.",
    "Pflanzendrink und weiche Butter dazugeben.",
    "10 Minuten kneten, bis der Teig glatt ist und nicht mehr klebt.",
    "Abgedeckt 1 Stunde gehen lassen.",
    "Butter für die Füllung schmelzen, mit Zucker und Zimt verrühren.",
    "Füllung abkühlen lassen, bis sie fester wird.",
    "Auflaufform einfetten.",
    "Teig zu einem Rechteck ausrollen.",
    "Füllung gleichmäßig verstreichen.",
    "Von der langen Seite aufrollen.",
    "In 12 Scheiben schneiden.",
    "In die Auflaufform legen.",
    "Abgedeckt nochmal 30 Minuten gehen lassen.",
    "Ofen auf 180°C Ober-/Unterhitze vorheizen.",
    "Schnecken mit etwas Pflanzendrink bepinseln.",
    "25 Minuten backen, bis goldbraun.",
    "Etwas abkühlen lassen.",
    "Puderzucker mit Pflanzendrink glattrühren.",
    "Über die lauwarmen Schnecken verteilen."
  ],
