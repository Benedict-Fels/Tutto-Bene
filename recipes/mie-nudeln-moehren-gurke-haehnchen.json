  "steps": [
    "Erdnussbutter leicht erwärmen.",
    "Knoblauch pressen, in die Erdnussbutter geben.",
    "Zitronensaft, Sriracha, Sweet Chili Sauce und Sojasauce dazu, gut verrühren.",
    "Karotten schälen und in Streifen schneiden.",
    "Gurke halbieren, entkernen, in Stücke schneiden.",
    "Frühlingszwiebeln in Ringe schneiden.",
    "Mie-Nudeln in Stücke brechen, mit kochendem Wasser übergießen, 5 Minuten quellen lassen, abgießen.",
    "Öl in Pfanne erhitzen, Hähnchen 6 Minuten anbraten, herausnehmen.",
    "Öl in großer Pfanne erhitzen, Karotten 8 Minuten anbraten.",
    "Gurke und Frühlingszwiebeln dazu, 3 Minuten mitbraten.",
    "Erdnusssoße, Hähnchen und Nudeln dazugeben, gut vermischen, 3 Minuten erhitzen.",
    "Mit Petersilie und Erdnüssen bestreuen."
  ],
