  "steps": [
    "Zwiebel fein würfeln, Knoblauch pressen.",
    "Zucchini würfeln, Paprika in Stücke schneiden.",
    "Kirschtomaten halbieren.",
    "Öl in großem Topf erhitzen, Zwiebeln 5 Minuten anbraten.",
    "Zucchini und Paprika dazu, 2 Minuten mitbraten.",
    "Currypaste und Knoblauch dazu, 2 Minuten mitbraten.",
    "Kokosmilch, Tomatenstücke, Brühepulver und Zucker dazugeben und vermischen.",
    "Aufkochen lassen.",
    "Nudeln dazu, 10 Minuten mit Deckel köcheln.",
    "Kirschtomaten und Erbsen dazu, weitere 5 Minuten köcheln.",
    "Zitronensaft und Pfeffer dazugeben."
