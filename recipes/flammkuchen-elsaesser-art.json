  "steps": [
    "Mehl und Salz in Schüssel mischen.",
    "Wasser und Öl dazu, gut durchkneten.",
    "Abgedeckt 30 Minuten ruhen lassen.",
    "Crème fraîche mit Zitronensaft und etwas Salz verrühren.",
    "Rote Zwiebeln schälen, halbieren, in feine Streifen schneiden.",
    "Zwiebelstreifen mit etwas Salz und Zucker vermischen, mit der Hand kneten, bis sie weich werden.",
    "5 Minuten ruhen lassen.",
    "Räuchertofu fein zerkrümeln, mit etwas Öl, Salz und Zucker vermischen.",
    "5 Minuten ruhen lassen.",
    "Ofen auf 250°C Ober-/Unterhitze vorheizen.",
    "Backblech mit Backpapier auslegen.",
    "Teig dünn auf Backblechgröße ausrollen.",
    "Auf das Backblech legen.",
    "Creme gleichmäßig bis zum Rand verteilen.",
    "Räuchertofu-Speck und Zwiebeln gleichmäßig verteilen.",
    "17 Minuten auf mittlerer Schiene backen.",
    "Mit Pfeffer und nach Belieben Petersilie bestreuen."
  ],
