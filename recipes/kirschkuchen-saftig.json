    { "amount": 12, "unit": "g", "name": "Backpulver", "variety": "Weinstein-Backpulver" },
    { "amount": 2, "unit": "g", "name": "Salz", "variety": null },
    { "amount": 115, "unit": "g", "name": "Pflanzenöl", "variety": "neutral" },
    { "amount": 180, "unit": "ml", "name": "Pflanzendrink", "variety": "Soja" },
    { "amount": 125, "unit": "ml", "name": "Mineralwasser", "variety": "mit Kohlensäure" },
