  "steps": [
    "Kirschen gründlich in einem Sieb abtropfen lassen.",
    "Ofen auf 180 °C Ober-/Unterhitze vorheizen.",
    "Springform mit Öl einfetten, mit Mehl bestäuben.",
    "Mehl, Zucker, Vanillezucker, Backpulver und Salz vermischen.",
    "Öl, Pflanzendrink und Mineralwasser dazu, kurz mit dem Löffel verrühren.",
    "Kirschen mit Mehl wenden, damit sie nicht absinken.",
    "Vorsichtig unter den Teig heben.",
    "In die Springform füllen.",
    "60 Minuten auf mittlerer Schiene backen.",
    "Vollständig in der Form auskühlen lassen.",
    "Nach Belieben mit Puderzucker bestäuben."
  ],
