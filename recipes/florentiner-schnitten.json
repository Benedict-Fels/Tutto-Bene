  "steps": [
    "Mehl, Puderzucker, Vanillezucker und Salz vermischen.",
    "Butter dazu, zu Teig verkneten.",
    "Zur Kugel formen, in Folie wickeln, 30 Minuten kalt stellen.",
    "Orangeat fein hacken, mit etwas Mehl bestäuben.",
    "Butter, Sahne, Zucker, Vanillezucker und Salz erhitzen, bis sich der Zucker löst.",
    "Mandelblättchen und Orangeat unterrühren.",
    "Ofen auf 160 °C Umluft vorheizen.",
    "Backblech einfetten, mit Backpapier auslegen.",
    "Teig gleichmäßig auf das Blech geben.",
    "Florentiner-Masse gleichmäßig darauf verteilen.",
    "35 Minuten auf mittlerer Schiene backen.",
    "15 Minuten abkühlen lassen, in Rechtecke schneiden.",
    "Schokolade über Wasserbad schmelzen.",
    "Beide Enden jedes Stücks in Schokolade tunken, trocknen lassen."
  ],
