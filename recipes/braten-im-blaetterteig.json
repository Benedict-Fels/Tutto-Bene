  "steps": [
    "Zwiebeln fein würfeln, Knoblauch pressen.",
    "Champignons putzen und fein hacken. Maronen und Räuchertofu fein hacken.",
    "Leinsamen mit 5 EL Wasser verrühren, quellen lassen.",
    "Öl erhitzen, Zwiebeln 5 Minuten anbraten.",
    "Knoblauch dazu, 1 Minute mitbraten.",
    "Champignons, Maronen und Tofu dazu, 10 Minuten offen anbraten.",
    "Wasser und Brühepulver dazu, 5 Minuten köcheln.",
    "Tomatenmark, Senf, Sojasauce, Oregano und Rosmarin einrühren, 10 Minuten offen köcheln.",
    "Mit Pfeffer abschmecken.",
    "Leinsamenmischung, Sahne und Panko unterrühren.",
    "Ofen auf 180°C vorheizen.",
    "Blätterteig ausrollen, Füllung mittig darauflegen.",
    "Ränder über die Füllung schlagen, andrücken, Enden verschließen.",
    "Mit Sahne bestreichen, nach Belieben aus Resten verzieren.",
    "55 Minuten bei 180°C backen, bis goldbraun."
  ],
